# Copy to .env (loaded via node --env-file-if-exists). Never commit .env. No real keys belong in this file.

PORT=3000
# Localhost by default. A non-loopback HOST requires API_KEY (server refuses to start otherwise).
HOST=127.0.0.1
LOG_LEVEL=info

# --- Public collection (default workflow) -------------------------------------------------
# OpenDART key (free, https://opendart.fss.or.kr). The ONLY key you need for filings/statements.
# Without it Naver quote/news are still collected, but no valuation can be produced.
DART_API_KEY=
# Optional Naver Open API (news search for product-market queries). Ticker news works without them.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Claude + agy (Antigravity CLI) — local logins, NO API keys ---------------------------------
# Claude: `claude` on PATH, logged in. agy: `curl -fsSL https://antigravity.google/cli/install.sh | bash`, then `npm run agy:login`.
# Either one is enough (an expired/unavailable one is skipped; the result is then not cross-checked).
# Paid routes (ANTHROPIC_API_KEY, GOOGLE_API_KEY, GOOGLE_CLOUD_PROJECT) are never forwarded to the CLIs.
# Optional overrides (server config only):
# INTELLIGENCE_CLAUDE_PATH=
# INTELLIGENCE_AGY_PATH=          (default: ~/.local/bin/agy, else `agy` on PATH)
# INTELLIGENCE_CLAUDE_MODEL=
# INTELLIGENCE_AGY_MODEL=         (default: gemini-3.8-flash-high; list with `agy models`)
# Per-CLI-call timeout (draft or audit). Default 600000 (10min): a full dataset draft with estimates/competitors/
# strategy fields is a long generation. Never silently shortened by RESEARCH_JOB_TIMEOUT_MS below -- see there.
# INTELLIGENCE_TIMEOUT_MS=600000
# Claude Code --effort (low/medium/high/xhigh/max). Default "medium"; an invalid value is diagnosed and falls back
# to the default (never crashes an analysis).
# INTELLIGENCE_CLAUDE_EFFORT=medium
# INTELLIGENCE_MAX_CONCURRENT=2
# Model-facing evidence character budget (default 90000, clamped to 20000..200000). The FULL raw collection is
# unaffected; only what is sent to the models is trimmed, with a guaranteed minimum share per document class (quote,
# statements, filing text/tables, reference, news) so no one class (e.g. many statement quarters) can starve the
# others -- see docs/README troubleshooting notes.
# INTELLIGENCE_EVIDENCE_CHAR_BUDGET=90000

# --- Auth and limits ------------------------------------------------------------------------
# Optional. When set, dataset mutation and every public analysis/research job (and its result) needs header "x-api-key".
API_KEY=
# Directory for manually ingested datasets: <DATA_DIR>/<ticker>.json
DATA_DIR=./data/manual
# Explicit demo (fictional fixtures). Defaults to true, except false when NODE_ENV=production.
DEMO_MODE_ENABLED=true
# In-memory jobs (lost on restart)
RESEARCH_MAX_RUNNING=2
RESEARCH_MAX_PENDING=10
RESEARCH_MAX_RETAINED=100
RESEARCH_JOB_TTL_MS=3600000
# Whole-job deadline (JobManager AbortController). Left unset here on purpose: the default is DERIVED from
# INTELLIGENCE_TIMEOUT_MS (per-call x 3 sequential calls + 300000ms overhead), so it always has room for a full
# claude-draft -> agy-draft-fallback -> audit sequence even if you change the per-call timeout above. Set this
# explicitly only to impose a hard ceiling shorter (or longer, up to 7200000) than that derived default; it is
# always honored exactly as set (a too-small value is diagnosed in the server log, never silently raised).
# RESEARCH_JOB_TIMEOUT_MS=2100000
# earnings-gap-auto/v1 automatic path (docs/STRATEGY.md "자동 연결"): a portfolio assumption, so it is never
# invented. Unset (default) means the funding-gap check uses 0 (no buffer), and the result says so explicitly.
# STRATEGY_MIN_CASH_BUFFER_KRW=
