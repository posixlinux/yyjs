{
  "name": "kospi-product-market-server",
  "version": "1.1.0",
  "private": true,
  "description": "KOSPI product market analysis server: public DART/Naver collection, Claude+agy review, deterministic valuation (no trading)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/main.js",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "doctor": "tsx --env-file-if-exists=.env src/doctor.ts",
    "agy:login": "node scripts/agy-login.mjs",
    "smoke:public": "tsx --env-file-if-exists=.env scripts/smoke-public.ts",
    "smoke:job": "tsx --env-file-if-exists=.env scripts/smoke-job.ts",
    "strategy": "tsx --env-file-if-exists=.env scripts/strategy-cli.ts",
    "forecast:synthetic": "tsx scripts/forecast-synthetic.ts"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
